DATABASE_URL="postgresql://postgres:password@localhost:5432/mission_control"
PORT=3001
NODE_ENV=development
HEALTH_CHECK_INTERVAL_MS=300000
HEALTH_CHECK_TIMEOUT_MS=5000
FRONTEND_ORIGIN=http://localhost:5173

# Agent health endpoint overrides (optional)
AGENT_NEXUS_HEALTH_URL=http://localhost:4001/health
AGENT_CIPHER_HEALTH_URL=http://localhost:4002/health
AGENT_RELAY_HEALTH_URL=http://localhost:4003/health

# Agent API keys — each agent must include its key in every inbound request:
#   Authorization: Bearer <API_KEY>
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_NEXUS_API_KEY=replace_with_secure_random_key
AGENT_CIPHER_API_KEY=replace_with_secure_random_key
AGENT_RELAY_API_KEY=replace_with_secure_random_key
